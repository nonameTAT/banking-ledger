@startuml
title Banking Ledger - Project Class Diagram

skinparam packageStyle rectangle
hide empty members
left to right direction

' Services map their own request and response DTOs; those same-package edges
' are left out so the cross-package structure stays readable.

package "com.owo.banking_ledger.account" as account {
  class Account <<entity>> {
    - Long id
    - String accountNumber
    - String ownerName
    - String currency
    - AccountStatus status
    - BigDecimal balance
    - Long version
    - Instant createdAt
    - AccountKind accountKind
    - AccountCategory accountCategory
    + debit(BigDecimal amount)
    + credit(BigDecimal amount)
    + freeze()
    + unfreeze()
  }

  enum AccountStatus {
    ACTIVE
    FROZEN
    CLOSED
  }

  enum AccountKind {
    CUSTOMER
    SYSTEM
  }

  enum AccountCategory {
    ASSET
    LIABILITY
  }

  interface AccountRepository <<repository>> {
    + existsByAccountNumber(String accountNumber)
    + existsByAccountNumberAndAccountKind(String accountNumber, AccountKind kind)
    + findByAccountNumber(String accountNumber)
    + findByIdForUpdate(Long id)
    + findByAccountNumberForUpdate(String accountNumber)
  }

  class SystemAccounts <<utility>> {
    + {static} cashAccountNumber(String currency)
  }

  class AccountService <<service>> {
    + create(CreateAccountRequest request)
    + findById(Long id)
    + freeze(Long id)
    + unfreeze(Long id)
    - validateSupportedCurrency(String currency)
    - validateCustomerAccount(Account account, String operation)
  }

  class AccountController <<controller>> {
    + create(CreateAccountRequest request)
    + findById(Long id)
    + freeze(Long id)
    + unfreeze(Long id)
  }

  class CreateAccountRequest <<dto>> {
    ownerName: String
    currency: String
  }

  class AccountResponse <<dto>> {
    id: Long
    accountNumber: String
    ownerName: String
    currency: String
    status: AccountStatus
    balance: BigDecimal
    createdAt: Instant
  }

  class AccountNotFoundException <<exception>>
}

package "com.owo.banking_ledger.ledger" as ledger {
  class LedgerTransaction <<entity>> {
    - Long id
    - String referenceId
    - TransactionType transactionType
    - TransactionStatus status
    - BigDecimal amount
    - String currency
    - String description
    - Instant createdAt
    - String requestHash
    - LedgerTransaction reversalOf
    + {static} reversing(LedgerTransaction original, String referenceId, String description, String requestHash)
    + isReversal()
    + markReversed()
    + complete()
    + fail()
  }

  class LedgerEntry <<entity>> <<immutable>> {
    - Long id
    - LedgerTransaction transaction
    - Account account
    - EntryType entryType
    - BigDecimal amount
    - BigDecimal balanceAfter
    - Instant createdAt
  }

  enum TransactionType {
    DEPOSIT
    WITHDRAWAL
    TRANSFER
    REVERSAL
  }

  enum TransactionStatus {
    PENDING
    COMPLETED
    FAILED
    REVERSED
  }

  enum EntryType {
    DEBIT
    CREDIT
  }

  interface LedgerTransactionRepository <<repository>> {
    + findByReferenceId(String referenceId)
    + findByIdForUpdate(Long id)
  }

  interface LedgerEntryRepository <<repository>> {
    + saveAll(Iterable<LedgerEntry> entries)
    + saveAndFlush(LedgerEntry entry)
    + findById(Long id)
    + findByAccountId(Long accountId, Pageable pageable)
    + findByTransactionId(Long transactionId)
  }

  class IdempotencyService <<service>> {
    + claim(String referenceId, String requestHash)
    - lock(String referenceId)
  }

  class LedgerQueryService <<service>> {
    + findAccountEntries(Long accountId, Pageable pageable)
  }

  class LedgerQueryController <<controller>> {
    + findEntries(Long accountId, Pageable pageable)
  }

  class LedgerEntryResponse <<dto>> {
    id: Long
    transactionId: Long
    referenceId: String
    transactionType: TransactionType
    entryType: EntryType
    amount: BigDecimal
    balanceAfter: BigDecimal
    createdAt: Instant
  }

  class LedgerEntryPageResponse <<dto>>

  class IdempotencyConflictException <<exception>>
  class ReversalNotAllowedException <<exception>>
  class TransactionNotFoundException <<exception>>
}

package "com.owo.banking_ledger.deposit" as deposit {
  class DepositService <<service>> {
    + deposit(Long accountId, DepositRequest request)
    - replayResponse(LedgerTransaction transaction, Long accountId)
    - {static} fingerprint(Long accountId, DepositRequest request)
  }

  class DepositController <<controller>> {
    + deposit(Long accountId, DepositRequest request)
  }

  class DepositRequest <<dto>> {
    amount: BigDecimal
    currency: String
    referenceId: String
    description: String
  }

  class DepositResponse <<dto>> {
    transactionId: Long
    referenceId: String
    accountId: Long
    amount: BigDecimal
    currency: String
    status: TransactionStatus
    balanceAfter: BigDecimal
  }

  class DuplicateTransactionException <<exception>>
}

package "com.owo.banking_ledger.withdrawal" as withdrawal {
  class WithdrawalService <<service>> {
    + withdraw(Long accountId, WithdrawalRequest request)
    - replayResponse(LedgerTransaction transaction, Long accountId)
    - {static} fingerprint(Long accountId, WithdrawalRequest request)
  }

  class WithdrawalController <<controller>> {
    + withdraw(Long accountId, WithdrawalRequest request)
  }

  class WithdrawalRequest <<dto>> {
    amount: BigDecimal
    currency: String
    referenceId: String
    description: String
  }

  class WithdrawalResponse <<dto>> {
    transactionId: Long
    referenceId: String
    accountId: Long
    amount: BigDecimal
    currency: String
    status: TransactionStatus
    balanceAfter: BigDecimal
  }
}

package "com.owo.banking_ledger.transfer" as transfer {
  class TransferService <<service>> {
    + transfer(TransferRequest request)
    - replayResponse(LedgerTransaction transaction, TransferRequest request)
    - {static} fingerprint(TransferRequest request)
  }

  class TransferController <<controller>> {
    + transfer(TransferRequest request)
  }

  class TransferRequest <<dto>> {
    sourceAccountId: Long
    targetAccountId: Long
    amount: BigDecimal
    currency: String
    referenceId: String
    description: String
  }

  class TransferResponse <<dto>> {
    transactionId: Long
    referenceId: String
    sourceAccountId: Long
    targetAccountId: Long
    amount: BigDecimal
    currency: String
    status: TransactionStatus
    sourceBalanceAfter: BigDecimal
    targetBalanceAfter: BigDecimal
  }
}

package "com.owo.banking_ledger.reversal" as reversal {
  class ReversalService <<service>> {
    + reverse(Long transactionId, ReversalRequest request)
    - lockAccounts(List<LedgerEntry> originalEntries)
    - {static} validateReversible(LedgerTransaction original)
    - {static} mirror(EntryType entryType)
    - {static} fingerprint(Long transactionId, ReversalRequest request)
  }

  class ReversalController <<controller>> {
    + reverse(Long transactionId, ReversalRequest request)
  }

  class ReversalRequest <<dto>> {
    referenceId: String
    description: String
  }

  class ReversalResponse <<dto>> {
    transactionId: Long
    referenceId: String
    originalTransactionId: Long
    originalReferenceId: String
    amount: BigDecimal
    currency: String
    status: TransactionStatus
  }
}

package "com.owo.banking_ledger.audit" as audit {
  class AuditLog <<entity>> {
    - Long id
    - AuditAction action
    - Long accountId
    - Long relatedAccountId
    - Long transactionId
    - String referenceId
    - BigDecimal amount
    - String currency
    - String details
    - Instant createdAt
  }

  enum AuditAction {
    ACCOUNT_CREATED
    ACCOUNT_FROZEN
    ACCOUNT_UNFROZEN
    DEPOSIT_COMPLETED
    WITHDRAWAL_COMPLETED
    TRANSFER_COMPLETED
    TRANSACTION_REVERSED
  }

  interface AuditLogRepository <<repository>> {
    + findByAccountIdOrRelatedAccountIdOrderByCreatedAtDesc(...)
    + findByAccountIdInOrRelatedAccountIdIn(...)
  }

  class AuditLogService <<service>> {
    + recordAccountEvent(AuditAction action, Long accountId, String details)
    + recordTransactionEvent(AuditAction action, Long accountId, Long relatedAccountId, LedgerTransaction transaction, BigDecimal amount, String currency, String details)
    + findAccountAuditLogs(Long accountId, Pageable pageable)
  }

  class AuditLogController <<controller>> {
    + findAuditLogs(Long accountId, Pageable pageable)
  }

  class AuditLogResponse <<dto>>
  class AuditLogPageResponse <<dto>>
}

package "com.owo.banking_ledger.common" as common {
  class BusinessException <<exception>> {
    - BusinessErrorCode code
    + getCode()
    + {static} invalidRequest(String message)
  }

  enum BusinessErrorCode {
    ACCOUNT_NOT_FOUND
    TRANSACTION_NOT_FOUND
    DUPLICATE_TRANSACTION
    DATA_INTEGRITY_VIOLATION
    IDEMPOTENCY_PAYLOAD_MISMATCH
    REVERSAL_NOT_ALLOWED
    INVALID_REQUEST
  }

  class RequestFingerprint <<utility>> {
    + {static} of(String... parts)
    + {static} normalize(BigDecimal amount)
    + {static} lockKey(String referenceId)
  }

  class ErrorResponse <<dto>> {
    timestamp: Instant
    code: BusinessErrorCode
    message: String
  }

  class GlobalExceptionHandler <<advice>> {
    + handleBusinessException(BusinessException exception)
    + handleDataIntegrityViolation(DataIntegrityViolationException exception)
    + handleValidation(MethodArgumentNotValidException exception)
    + handleIllegalArgument(IllegalArgumentException exception)
    + handleIllegalState(IllegalStateException exception)
  }

  class OpenApiConfig <<config>>
}

note right of LedgerEntry
  Append-only. Mapped @Immutable, the
  repository exposes no update or delete,
  and a database trigger rejects any
  UPDATE or DELETE on ledger_entries.
end note

note right of IdempotencyService
  Takes a transaction-scoped advisory lock on
  the reference id, then returns the original
  transaction when the request repeats it.
  A different payload under the same reference
  id is rejected as a conflict.
end note

